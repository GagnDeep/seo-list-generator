{
  "name": "@openclaw/ai-ops-cli",
  "version": "0.1.0",
  "description": "Self-hosted AI cost and performance monitor for OpenAI, Anthropic, and other AI providers",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
