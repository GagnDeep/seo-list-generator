{
  "name": "@openclaw/dead-simple-deploy",
  "version": "1.0.0",
  "description": "One-command static site deployment to S3-compatible storage with automatic cache headers and CDN invalidation",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "deploy": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "deploy",
    "s3",
    "static-site",
    "cli",
    "cloudflare-r2",
    "aws",
    "cdn",
    "web-deploy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/dead-simple-deploy"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/client-cloudfront": "^3.500.0",
    "commander": "^12.0.0",
    "mime-types": "^2.1.35",
    "glob": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/mime-types": "^2.1.4",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
