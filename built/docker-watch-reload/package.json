{
  "name": "@seo-list/docker-watch-reload",
  "version": "0.1.0",
  "description": "Watch source files and automatically rebuild Docker containers on change",
  "license": "MIT",
  "author": "seo-list",
  "repository": {
    "type": "git",
    "url": "https://github.com/seo-list/docker-watch-reload"
  },
  "keywords": [
    "docker",
    "watch",
    "reload",
    "hot-reload",
    "docker-compose",
    "development"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "docker-watch": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:ci": "vitest run"
